generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  USER
  ADMIN
}

enum Category {
  POTHOLE
  GARBAGE
  STREETLIGHT
  WATER_LEAKAGE
  ROAD_DAMAGE
  SEWAGE
  DRAINAGE
  OTHER
}

enum Status {
  PENDING
  REVIEWING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================================
// MODELS
// ============================================================

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String?
  googleId  String?  @unique
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  issuesReported Issue[]        @relation("CreatedIssues")
  issuesAssigned Issue[]        @relation("AssignedIssues")
  histories      IssueHistory[] @relation("UserHistories")
  notifications  Notification[] @relation("UserNotifications")
}

model Issue {
  id               Int      @id @default(autoincrement())
  title            String
  description      String
  category         Category @default(OTHER)
  status           Status   @default(PENDING)
  priority         Priority @default(MEDIUM)
  imageUrl         String?
  latitude         Float?
  longitude        Float?
  address          String?
  aiClassification String?
  aiConfidence     Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Creator Relationship
  createdById Int
  createdBy   User @relation("CreatedIssues", fields: [createdById], references: [id])

  // Assigned Admin Relationship
  assignedToId Int?
  assignedTo   User? @relation("AssignedIssues", fields: [assignedToId], references: [id])

  // Related Records
  histories     IssueHistory[]
  notifications Notification[]
}

model IssueHistory {
  id          Int      @id @default(autoincrement())
  issueId     Int
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  changedById Int
  changedBy   User     @relation("UserHistories", fields: [changedById], references: [id])
  oldStatus   Status?
  newStatus   Status
  comment     String?
  createdAt   DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  issueId   Int?
  issue     Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}